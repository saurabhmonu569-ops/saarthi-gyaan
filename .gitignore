node_modules/

# Build output
dist/
.vite/

# Build-pipeline scratch data (2026-07-27, git setup): 36,800+ small
# per-page/per-chunk intermediate files from the original book-processing
# pipeline (OCR raw text + chunk splits). NOT read by the live app at
# runtime (app fetches from public/knowledge/* only) — this is reproducible
# scratch output, keeping it out of git so the repo stays fast to clone/push.
data/chunks/
data/raw/
# Legacy pre-split knowledge files (~118MB) — superseded by public/knowledge/
# (split-v1 format the live app actually reads). Confirmed unused at runtime.
data/knowledge/knowledge.json
data/knowledge/search_manifest.json
# 2026-08-05: public/ ki WAHI do files bhi. Upar wala niyam sirf data/ par
# laga tha, par `Copy-Item data\knowledge\*.json public\knowledge\` inhe
# public/ mein bhi rakh deta hai — aur wahan se ye git mein chali gayi thin.
#
# App inhe padhti hi nahi: engine.js pehle split-v1 (meta.json + books/ +
# index/) uthata hai; ye do sirf catch-block ka legacy fallback hain, jo
# split-v1 maujood hone par kabhi nahi chalta. 05_split_knowledge.py inhe
# INPUT ki tarah padhti hai, isliye disk par rehne dena hai — sirf commit
# nahi karna.
#
# Kyun zaroori: knowledge.json 94MB par pahunch chuki hai. GitHub 100MB se
# badi file ka push SEEDHE REJECT kar deta hai. Agli ek kitab bhi jodi to
# push hamesha ke liye fail hone lagta. Ye do hatane se har deploy 152MB
# halka bhi ho jaata hai.
public/knowledge/knowledge.json
public/knowledge/search_manifest.json

# 2026-08-10 — UPLOAD KE CHECKPOINT. Ye commit karna KHATARNAK hai.
#
# 11_upload_vectorize.mjs aur 12_load_d1.mjs beech mein ruk jaayein to inhi
# files se aage badhte hain. Inme likha hai {"total":57339,"done":57339}.
#
# Agar ye git mein rahein, to kal koi (ya khud aap, naye computer par) repo
# clone karke `node scripts/12_load_d1.mjs --load` chalayega — aur script
# checkpoint padh kar kahegi "sab ho chuka hai", 0 ansh bhejegi, aur
# KHAALI D1 par "✅ ho gaya" chhaap degi. Galti tab pata chalegi jab Ask
# har sawaal ka jawab "koi granth nahi mila" dene lagega.
#
# Ye checkpoint us MACHINE ka haal hai, project ka nahi.
public/knowledge/.d1-progress.json
public/knowledge/embeddings/.vectorize-progress.json
public/knowledge/embeddings/.embed-progress.json

# Naap ke nateeje — ye ek RUN ka haal hain, project ka nahi. Har baar
